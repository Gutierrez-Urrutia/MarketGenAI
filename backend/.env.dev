# App
APP_NAME="NoonDalton AI Marketing Suite"
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=Quigonjinjed1**
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
LOCAL_DEV_AUTH_ENABLED=true
LOCAL_DEV_AUTH_EMAIL=admin@noondalton.com
LOCAL_DEV_AUTH_PASSWORD=admin123
LOCAL_DEV_AUTH_NAME="Admin User"
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Google Cloud / Firestore
GOOGLE_CLOUD_PROJECT=bigdataduoc2026-org
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"bigdataduoc2026-org"}
FIRESTORE_DATABASE=(default)

# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Meta (Facebook Pages + linked Instagram Business account)
# Create the app at https://developers.facebook.com/apps, add the
# "Facebook Login" product, and add this exact callback under
# Valid OAuth Redirect URIs: {your-backend-url}/api/v1/settings/social/facebook/callback
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/settings/social/facebook/callback
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=your-meta-access-token

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# X / Twitter
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_API_KEY=your-twitter-consumer-api-key
TWITTER_API_SECRET=your-twitter-consumer-api-secret

# Gemini LLM
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GEMINI_DEFAULT_MODEL=gemini-2.0-flash-lite
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=nd-assets

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
