# ── OBLIGATORIAS EN PRODUCCIÓN (APP_ENV=production) ──────────────────────────────────────────────
# Si falta alguna, el arranque se detiene y el mensaje las lista todas. Ver docs/MANUAL-DESPLIEGUE.md, sección 3:
#   APP_SECRET_KEY, GOOGLE_CLOUD_PROJECT, DEEPSEEK_API_KEY, PIPELINE_ENCRYPTION_KEY, STORAGE_BACKEND=gcs y GCS_BUCKET.
# En Cloud Run las credenciales de Firestore salen de la cuenta de servicio del servicio (no hace falta archivo).

# App
APP_NAME="MarketGen AI"
APP_ENV=development
APP_DEBUG=true
# Firma de los JWT. Larga y aleatoria (python -c "import secrets; print(secrets.token_urlsafe(48))").
APP_SECRET_KEY=replace-with-a-long-random-secret
# Detrás de un proxy propio: usar el primer X-Forwarded-For como IP de la auditoría (cualquiera puede enviar esa cabecera).
TRUST_PROXY_HEADERS=false
# Correos con rol admin además de los asignados en Firestore (separados por coma).
ADMIN_EMAILS=
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
# Qué proceso corre el contenedor (backend/start.sh): all, api o worker.
ROLE=all
CELERY_CONCURRENCY=2
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=60
# Cuenta de desarrollo con contraseña conocida: DESACTIVAR en producción real (LOCAL_DEV_AUTH_ENABLED=false).
LOCAL_DEV_AUTH_ENABLED=true
LOCAL_DEV_AUTH_EMAIL=admin@noondalton.com
LOCAL_DEV_AUTH_PASSWORD=admin123
LOCAL_DEV_AUTH_NAME="Admin User"
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app

# Google Cloud / Firestore
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/service-account.json
# Opcional: el JSON completo de la cuenta de servicio en una línea (si se define, debe ser un JSON válido).
# FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE=(default)

# Login con Microsoft (Entra ID, inquilino único: solo entran las cuentas de tu organización).
# Es una app distinta de la del buzón de envío (MAIL_OAUTH_* más abajo). Los tres valores se piden juntos: si pones
# el ID de cliente, el secreto y el ID del directorio (GUID) son obligatorios en producción.
# La URI de redirección debe estar registrada tal cual en Entra ID (plataforma Web); vacía = se arma con el host de la petición.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=

# Google OAuth
OAUTH_REDIRECT_BASE_URL=http://127.0.0.1:8000/api/v1
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Meta (Facebook Pages + linked Instagram Business account)
# Create the app at https://developers.facebook.com/apps, add the
# "Facebook Login" product, and add this exact callback under
# Valid OAuth Redirect URIs: {your-backend-url}/api/v1/settings/social/facebook/callback
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://127.0.0.1:8000/api/v1/settings/social/facebook/callback
META_GRAPH_API_VERSION=v21.0
META_ACCESS_TOKEN=your-meta-access-token

# LinkedIn
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# X / Twitter
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_API_KEY=your-twitter-consumer-api-key
TWITTER_API_SECRET=your-twitter-consumer-api-secret

# DeepSeek (IA)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Tiempo máximo de cada llamada a la IA, en segundos (sin definir = sin límite). Sin límite no existe «tiempo agotado»: se recomienda fijarlos.
# LLM_SHORT_TIMEOUT_SECONDS=30
# LLM_DEFAULT_TIMEOUT_SECONDS=120
# LLM_LONG_TIMEOUT_SECONDS=300

# CRM (HubSpot / Salesforce): las credenciales las guarda cada usuario cifradas en Firestore, no son variables.
HUBSPOT_BASE_URL=https://api.hubapi.com
SALESFORCE_API_VERSION=v61.0

# Archivos generados: gcs (Google Cloud Storage) en producción. Con supabase (valor por defecto del código, ya sin uso) el arranque
# en producción se detiene.
STORAGE_BACKEND=gcs
GCS_BUCKET=your-gcs-bucket

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Pipeline de prospección (3 agentes) — encripta las API keys de providers y
# los tokens OAuth del buzón antes de guardarlos en Firestore. Distinta de
# APP_SECRET_KEY (esa firma JWTs). Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIPELINE_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Envío real de correos de prospección desde la plataforma (RF-VTA-16).
# Interruptor maestro: apagado por defecto; cada usuario debe además
# encenderlo en Configuración.
OUTREACH_REAL_SEND_ENABLED=false

# Buzón de envío: cada usuario conecta su Microsoft 365 / Outlook por OAuth
# (RF-VTA-16). Registro de app propio en Entra ID, distinto del de login
# (MICROSOFT_OAUTH_*). El secreto se escribe solo aquí, en backend/.env (que
# git ignora): nunca en un chat, la terminal ni un commit.
# Mientras no exista el registro, un id de relleno y el Graph falso local.
MAIL_OAUTH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MAIL_OAUTH_CLIENT_SECRET=replace-with-the-client-secret
# Debe coincidir exactamente con la URI de redirección registrada.
MAIL_OAUTH_REDIRECT_URL=http://localhost:8000/api/v1/mail-connection/callback
# Gmail: quien entra con Google también puede enviar desde su Gmail. Usa el mismo cliente OAuth del login
# (GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET) y pide solo el permiso gmail.compose (crear borradores y
# enviar; no puede leer la bandeja). Hay que activar la API de Gmail en el proyecto de Google Cloud y registrar
# esta URI exacta en el cliente OAuth (Credenciales > URIs de redireccionamiento autorizados).
MAIL_GOOGLE_REDIRECT_URL=http://127.0.0.1:8000/api/v1/mail-connection/google/callback
# Entorno de pruebas (local y dev): si se define, TODO correo de prospección sale a estas direcciones (separadas por
# coma) y nunca al contacto real. En dev viene del secreto `outreach-redirect-to` de Secret Manager. Déjalo vacío
# solo donde de verdad se deba escribir a prospectos reales. Si tiene un valor inválido, no se envía nada.
OUTREACH_REDIRECT_TO=
# Endpoints de Microsoft. Otros valores (el Graph falso local) solo con
# MAIL_ALLOW_CUSTOM_ENDPOINTS=true y nunca con APP_ENV=production.
MICROSOFT_LOGIN_BASE_URL=https://login.microsoftonline.com
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
MAIL_ALLOW_CUSTOM_ENDPOINTS=false
# Tiempo máximo de cada llamada HTTP a Microsoft, en segundos.
MAIL_HTTP_TIMEOUT_SECONDS=20
