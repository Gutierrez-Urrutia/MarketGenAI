# Frontend (Vite). Estas variables se fijan AL COMPILAR: cambiarlas exige reconstruir (npm run build o la imagen).
# URL base de la API. En local: http://127.0.0.1:8000/api/v1. En producción: la URL de la API + /api/v1.
VITE_API_URL=http://127.0.0.1:8000/api/v1
# Acceso y aviso de demostración (apagados en producción real).
VITE_ENABLE_DEMO_LOGIN=false
VITE_SHOW_DEMO_BANNER=false
